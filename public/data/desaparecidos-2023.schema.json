{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yamacoa · Los 79 de 2023 (muertes y desapariciones atribuidas al Estado cubano)",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "kpis", "resumen", "casos", "proceso", "encuesta", "metodologia"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "actualizado", "periodo", "fuentePrincipal"],
      "properties": {
        "titulo": { "type": "string" },
        "subtitulo": { "type": "string" },
        "actualizado": { "type": "string" },
        "periodo": { "type": "string" },
        "fuentePrincipal": { "type": "string" },
        "advertencia": { "type": "string" },
        "descripcion": { "type": "string", "minLength": 400 },
        "narracion": { "type": "string", "minLength": 200 },
        "narracion_en": { "type": "string", "minLength": 200 }
      }
    },
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "valor", "etiqueta"],
        "properties": {
          "id": { "type": "string" },
          "valor": { "type": "number" },
          "etiqueta": { "type": "string" },
          "sufijo": { "type": "string" }
        }
      }
    },
    "resumen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalDocumentado", "categorias"],
      "properties": {
        "totalDocumentado": { "type": "number" },
        "totalReportado": { "type": "number" },
        "sinDocumentar": { "type": "number" },
        "nota": { "type": "string" },
        "categorias": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "etiqueta", "n"],
            "properties": {
              "id": { "type": "string" },
              "etiqueta": { "type": "string" },
              "n": { "type": "number" },
              "sub": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["etiqueta", "n"],
                  "properties": {
                    "etiqueta": { "type": "string" },
                    "n": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "casos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "fecha", "cat", "estado", "detalle"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "edad": { "type": ["number", "null"] },
          "fecha": { "type": "string" },
          "fechaAprox": { "type": "boolean" },
          "cat": { "type": "string", "enum": ["extrajudicial", "custodia", "smo", "internacionalista", "migrante"] },
          "sub": { "type": ["string", "null"] },
          "prov": { "type": ["string", "null"] },
          "lugar": { "type": "string" },
          "pais": { "type": "string" },
          "salida": { "type": ["string", "null"] },
          "ruta": { "type": ["string", "null"] },
          "estado": { "type": "string", "enum": ["muerto", "desaparecido"] },
          "detalle": { "type": "string" }
        }
      }
    },
    "proceso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "etapas"],
      "properties": {
        "titulo": { "type": "string" },
        "intro": { "type": "string" },
        "etapas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "orden", "titulo", "texto"],
            "properties": {
              "id": { "type": "string" },
              "orden": { "type": "integer" },
              "titulo": { "type": "string" },
              "rol": { "type": "string" },
              "texto": { "type": "string" }
            }
          }
        }
      }
    },
    "encuesta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "q", "opts"],
        "properties": {
          "id": { "type": "string" },
          "q": { "type": "string" },
          "opts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "t", "seed"],
              "properties": {
                "id": { "type": "string" },
                "t": { "type": "string" },
                "seed": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "metodologia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fuentes", "periodo", "extraccion", "limitaciones", "cambios_metodologicos"],
      "properties": {
        "fuentes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nombre", "tipo", "url"],
            "properties": {
              "nombre": { "type": "string" },
              "tipo": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "periodo": { "type": "string" },
        "cadencia": { "type": "string" },
        "extraccion": { "type": "string" },
        "validacion": { "type": "string" },
        "limitaciones": { "type": "array", "items": { "type": "string" } },
        "cambios_metodologicos": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
