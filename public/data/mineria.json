  "proceso_ni_co": [
    { "paso":1, "nombre":"Mina a cielo abierto",          "detalle":"Extracción de lateritas (limonita y saprolita) con draglines y camiones de 180-200 t. Operación 24 h en Moa, Holguín.",            "tipo":"extraccion" },
    { "paso":2, "nombre":"Trituración y clasificación",   "detalle":"Cribado húmedo: fracción <2 mm (limonita, alta Fe) y >2 mm (saprolita, alta Mg). El flujo principal es limonita.",                "tipo":"preparacion" },
    { "paso":3, "nombre":"Lixiviación ácida — HPAL",     "detalle":"Autoclave a 250 °C y 50 bar con H₂SO₄ concentrado. Disolución selectiva de Ni y Co; el Fe precipita como hematita.",              "tipo":"proceso" },
    { "paso":4, "nombre":"Separación sólido/líquido",    "detalle":"Lavado en contracorriente (CCD). Recuperación del licor cargado con Ni²⁺ y Co²⁺.",                                                 "tipo":"proceso" },
    { "paso":5, "nombre":"Neutralización",               "detalle":"Coral (CaCO₃) eleva el pH y precipita impurezas residuales: Fe, Al, Cr.",                                                          "tipo":"proceso" },
    { "paso":6, "nombre":"Precipitación — MSP",          "detalle":"H₂S gasoso precipita el sulfuro mixto de Ni-Co (Mixed Sulphide Precipitate). Producto final de la planta de Moa.",                  "tipo":"proceso" },
    { "paso":7, "nombre":"Transporte a refinería",       "detalle":"El MSP se embarcaba hacia Fort Saskatchewan (Alberta, Canadá). Cadena interrumpida desde junio 2026.",                             "tipo":"transporte", "alerta":true },
