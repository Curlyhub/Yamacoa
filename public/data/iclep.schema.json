{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yamacoa · expediente libertad de prensa (ICLEP)",
  "type": "object",
  "required": [
    "meta",
    "stats",
    "panorama",
    "tipos",
    "perpetradores",
    "prov",
    "olas",
    "contexto"
  ],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "titulo",
        "periodo",
        "actualizado",
        "fuente"
      ]
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "l"
        ],
        "properties": {
          "color": {
            "type": "string",
            "enum": [
              "salmon",
              "amarillo",
              "turquesa",
              "paper"
            ]
          }
        }
      }
    },
    "panorama": {
      "type": "object",
      "required": [
        "total",
        "expresion",
        "prensa"
      ]
    },
    "tipos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "t",
          "n",
          "pct"
        ]
      }
    },
    "perpetradores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "a",
          "pct"
        ]
      }
    },
    "perfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "g",
          "n"
        ]
      }
    },
    "genero": {
      "type": "object",
      "required": [
        "hombres",
        "mujeres"
      ]
    },
    "prov": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "p",
          "c"
        ]
      }
    },
    "olas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "f",
          "t",
          "d"
        ]
      }
    },
    "contexto": {
      "type": "object",
      "required": [
        "rank",
        "total",
        "fuente"
      ]
    }
  }
}