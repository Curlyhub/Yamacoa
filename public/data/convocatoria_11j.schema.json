{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yamacoa · convocatoria 11J (quinto aniversario)",
  "description": "Dataset respirante de la página de convocatoria del quinto aniversario del 11J (11 de julio de 2026): convocatorias mundiales con nivel de confianza explícito, propagación histórica de las protestas de 2021, cifras verificadas de represión y padrón nominal de presos del 11J. Tras el 11 de julio de 2026 este dataset se reconvierte en registro retrospectivo de la jornada (ver ops/convocatoria_11j/NOTAS.md).",
  "type": "object",
  "required": ["meta", "kpis", "convocatorias", "ciudades_en_duda", "historia_2021", "cifras", "caso_otero", "padron", "cta", "metodologia"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "titulo", "subtitulo", "actualizado", "evento_fecha", "modo", "nota_registro", "fuentes"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "titulo": { "type": "string" },
        "subtitulo": { "type": "string" },
        "actualizado": { "type": "string", "format": "date" },
        "evento_fecha": { "type": "string", "format": "date", "description": "Fecha de la jornada convocada. El hero calcula la cuenta atrás contra este campo." },
        "modo": {
          "type": "string",
          "enum": ["convocatoria", "retrospectiva"],
          "description": "convocatoria: página de agitación previa a la jornada. retrospectiva: registro de cómo fue la jornada (reconversión posterior al evento)."
        },
        "nota_registro": { "type": "string", "minLength": 80, "description": "Nota editorial visible: esta página es agitación con rigor de fuentes, un registro distinto al observacional del resto de Yamacoa." },
        "fuentes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "descripcion": { "type": "string", "minLength": 400 },
        "narracion": { "type": "string", "minLength": 300, "maxLength": 1450 },
        "narracion_en": { "type": "string", "minLength": 200 }
      }
    },
    "kpis": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "valor", "etiqueta"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "valor": { "type": "string", "description": "Texto ya formateado; admite suelos tipo «al menos 342»." },
          "etiqueta": { "type": "string" },
          "fuente": { "type": "string" }
        }
      }
    },
    "convocatorias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nombre", "ciudad", "pais", "lugar", "fecha", "tipo", "estado"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "nombre": { "type": "string" },
          "ciudad": { "type": "string" },
          "pais": { "type": "string" },
          "lugar": { "type": "string" },
          "fecha": { "type": "string", "format": "date" },
          "hora_inicio": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$", "description": "Hora LOCAL de la ciudad de la convocatoria." },
          "hora_fin": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
          "tipo": { "type": "string" },
          "organizadores": { "type": "array", "items": { "type": "string" } },
          "estado": {
            "type": "string",
            "enum": ["confirmado", "celebrado", "reportado_no_verificado", "plausible_no_confirmado", "especulativo"],
            "description": "Nivel de confianza INNEGOCIABLE en la UI: confirmado/celebrado (verificado por prensa propia), reportado_no_verificado (aportado por usuario, sin confirmación independiente), plausible_no_confirmado (patrón de fondo sólido, sin confirmación específica), especulativo (sin verificación propia). celebrado = confirmado y ya ocurrido."
          },
          "verificacion": { "type": "string", "description": "Qué se pudo verificar y qué no, en una o dos frases. Obligatoria de facto para estados no confirmados." },
          "fuente": { "type": ["string", "null"], "format": "uri" },
          "fuentes_contexto": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "notas": { "type": "string" },
          "programa": { "type": "array", "items": { "type": "string" } },
          "geo": {
            "type": ["object", "null"],
            "description": "null si el lugar no es geolocalizable (p. ej. ciudad sin identificar): la convocatoria sale en la lista pero no en el mapa.",
            "required": ["lat", "lon", "precision"],
            "additionalProperties": false,
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 },
              "precision": { "type": "string", "enum": ["local", "ciudad"], "description": "local: coordenada del punto de encuentro aproximado. ciudad: centroide urbano, sin punto exacto." }
            }
          }
        }
      }
    },
    "ciudades_en_duda": {
      "type": "array",
      "description": "Ciudades con patrón histórico de actos por el 11J o redes activas documentadas en 2026, pero SIN convocatoria específica localizada para la fecha. Se muestran como contexto, nunca como convocatorias.",
      "items": {
        "type": "object",
        "required": ["ciudad", "pais", "nota"],
        "additionalProperties": false,
        "properties": {
          "ciudad": { "type": "string" },
          "pais": { "type": "string" },
          "nota": { "type": "string" }
        }
      }
    },
    "historia_2021": {
      "type": "object",
      "required": ["resumen", "propagacion", "muerte", "detenciones"],
      "additionalProperties": false,
      "properties": {
        "resumen": {
          "type": "object",
          "required": ["texto"],
          "additionalProperties": false,
          "properties": {
            "texto": { "type": "string" },
            "localidades": { "type": "string" },
            "provincias": { "type": "string" },
            "fuente": { "type": "string" }
          }
        },
        "propagacion": {
          "type": "array",
          "minItems": 3,
          "description": "Hitos de propagación del 11-12 de julio de 2021. El campo id casa con la constante LOC_GEO congelada del renderer; un id desconocido se omite del mapa sin romper.",
          "items": {
            "type": "object",
            "required": ["id", "orden", "dia", "nombre", "texto"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "orden": { "type": "integer", "minimum": 1 },
              "dia": { "type": "string", "enum": ["2021-07-11", "2021-07-12"] },
              "nombre": { "type": "string" },
              "hora_aprox": { "type": ["string", "null"] },
              "texto": { "type": "string" },
              "fuente": { "type": "string" }
            }
          }
        },
        "muerte": {
          "type": "object",
          "required": ["nombre", "lugar", "fecha", "fuente"],
          "additionalProperties": false,
          "properties": {
            "nombre": { "type": "string" },
            "lugar": { "type": "string" },
            "fecha": { "type": "string", "format": "date" },
            "texto": { "type": "string" },
            "fuente": { "type": "string" }
          }
        },
        "detenciones": {
          "type": "object",
          "required": ["cifra", "fuente"],
          "additionalProperties": false,
          "properties": {
            "cifra": { "type": "string" },
            "fuente": { "type": "string" },
            "nota": { "type": "string" }
          }
        }
      }
    },
    "cifras": {
      "type": "object",
      "required": ["corte", "bloques"],
      "additionalProperties": false,
      "properties": {
        "corte": { "type": "string", "description": "Periodo de referencia del bloque de cifras, p. ej. «primer semestre de 2026»." },
        "bloques": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "valor", "etiqueta", "fuente", "fecha_corte"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "valor": { "type": "string" },
              "etiqueta": { "type": "string" },
              "detalle": { "type": "string" },
              "fuente": { "type": "string" },
              "fecha_corte": { "type": "string" }
            }
          }
        }
      }
    },
    "caso_otero": {
      "type": "object",
      "required": ["nombre", "hechos", "estado_actual", "actualizado", "fuente"],
      "additionalProperties": false,
      "properties": {
        "nombre": { "type": "string" },
        "quien": { "type": "string" },
        "hechos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["fecha", "texto"],
            "additionalProperties": false,
            "properties": {
              "fecha": { "type": "string", "format": "date" },
              "texto": { "type": "string" }
            }
          }
        },
        "estado_actual": { "type": "string" },
        "actualizado": { "type": "string", "format": "date" },
        "fuente": { "type": "string" }
      }
    },
    "padron": {
      "type": "object",
      "required": ["corte", "total", "en_prision", "nota_metodo", "fuente", "casos"],
      "additionalProperties": false,
      "properties": {
        "corte": { "type": "string", "format": "date" },
        "total": { "type": "integer", "minimum": 1 },
        "en_prision": { "type": "integer", "minimum": 0 },
        "nota_metodo": { "type": "string", "description": "Alcance del padrón: primera cohorte nominal, no la lista exhaustiva. Visible en la UI." },
        "fuente": { "type": "string" },
        "casos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "nombre", "estatus", "nivel_confianza", "url"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "nombre": { "type": "string" },
              "edad_detencion": { "type": ["integer", "null"], "minimum": 10, "maximum": 100 },
              "provincia": { "type": ["string", "null"] },
              "sentencia_anos": { "type": ["number", "null"], "minimum": 0 },
              "estatus": { "type": "string" },
              "nivel_confianza": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "cta": {
      "type": "object",
      "required": ["titulo", "intro", "acciones", "aviso"],
      "additionalProperties": false,
      "properties": {
        "titulo": { "type": "string" },
        "intro": { "type": "string" },
        "acciones": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["titulo", "texto"],
            "additionalProperties": false,
            "properties": {
              "titulo": { "type": "string" },
              "texto": { "type": "string" }
            }
          }
        },
        "aviso": { "type": "string", "description": "Marco explícito de resistencia civil pacífica, coherente con el expediente vias_cambio." }
      }
    },
    "metodologia": {
      "type": "object",
      "required": ["registro", "niveles", "limitaciones"],
      "additionalProperties": false,
      "properties": {
        "registro": { "type": "string", "description": "Cómo se construyó el listado de convocatorias y qué lo diferencia del registro observacional del resto de Yamacoa." },
        "niveles": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "etiqueta", "descripcion"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "etiqueta": { "type": "string" },
              "descripcion": { "type": "string" }
            }
          }
        },
        "limitaciones": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
