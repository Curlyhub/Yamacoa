{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yamacoa.com/data/desacreditacion.schema.json",
  "title": "Desacreditacion",
  "description": "Contrato del dataset respirante del expediente 'La maquinaria de desacreditar': campañas de desprestigio y patologización pseudo-clínica contra opositores cubanos no alineados, desde el oficialismo y desde sectores del propio exilio/diáspora. El caso Otero Alcántara (jul-2026) es ilustrativo de forma y función, nunca sujeto de diagnóstico.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "intro", "tacticas", "cronologia", "matriz", "caso_ilustrativo",
    "patron_iclep", "patron_cubalex", "diccionario_etiquetas", "verificacion",
    "encuesta", "referencias", "conclusion"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "titulo", "subtitulo", "version", "fecha_datos", "advertencia"],
      "properties": {
        "slug": { "const": "desacreditacion" },
        "titulo": { "type": "string" },
        "subtitulo": { "type": "string" },
        "descripcion": {
          "type": "string",
          "description": "Registro factual largo del expediente. Capa descriptiva (/narrar); no la consume el renderer congelado.",
          "minLength": 400
        },
        "narracion": {
          "type": "string",
          "description": "Guion de audio corto para el servidor TTS (tts.yamacoa.com). Cifras en palabras, español.",
          "minLength": 300,
          "maxLength": 1450
        },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "fecha_datos": { "type": "string", "format": "date" },
        "advertencia": { "type": "string", "minLength": 60 }
      }
    },
    "intro": {
      "type": "object",
      "required": ["parrafos"],
      "properties": {
        "parrafos": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 80 }
        }
      }
    },
    "tacticas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "nombre", "definicion", "frente"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "nombre": { "type": "string" },
          "definicion": { "type": "string", "minLength": 40 },
          "frente": { "type": "string", "enum": ["oficialista", "diaspora", "ambos"] }
        }
      }
    },
    "cronologia": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["fecha", "frente", "hecho", "confianza", "fuente"],
        "properties": {
          "fecha": { "type": "string" },
          "frente": { "type": "string", "enum": ["oficialista", "diaspora"] },
          "hecho": { "type": "string", "minLength": 20 },
          "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
          "fuente": { "type": "string", "minLength": 5 },
          "nota": { "type": "string" }
        }
      }
    },
    "matriz": {
      "type": "object",
      "required": ["nota", "filas"],
      "properties": {
        "nota": { "type": "string" },
        "filas": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["tactica_id", "oficialista", "diaspora"],
            "properties": {
              "tactica_id": { "type": "string" },
              "oficialista": { "type": "boolean" },
              "diaspora": { "type": "boolean" }
            }
          }
        }
      }
    },
    "caso_ilustrativo": {
      "type": "object",
      "required": ["advertencia", "hechos", "artefacto"],
      "properties": {
        "advertencia": { "type": "string", "minLength": 60 },
        "hechos": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["afirmacion", "confianza", "fuente"],
            "properties": {
              "afirmacion": { "type": "string", "minLength": 20 },
              "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
              "fuente": { "type": "string", "minLength": 5 },
              "nota": { "type": "string" }
            }
          }
        },
        "artefacto": {
          "type": "object",
          "required": ["forma", "funcion", "nota"],
          "properties": {
            "forma": { "type": "string", "minLength": 40 },
            "funcion": { "type": "string", "minLength": 40 },
            "nota": { "type": "string", "minLength": 20 }
          }
        }
      }
    },
    "patron_iclep": {
      "type": "object",
      "required": ["texto", "cifras", "caso_eltoque"],
      "properties": {
        "texto": { "type": "string", "minLength": 40 },
        "cifras": {
          "type": "object",
          "required": ["ataques", "victimas", "anio", "fuente"],
          "properties": {
            "ataques": { "type": "number", "minimum": 0 },
            "victimas": { "type": "number", "minimum": 0 },
            "anio": { "type": "integer" },
            "fuente": { "type": "string" }
          }
        },
        "caso_eltoque": {
          "type": "object",
          "required": ["texto", "confianza", "fuente"],
          "properties": {
            "texto": { "type": "string", "minLength": 30 },
            "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
            "fuente": { "type": "string" }
          }
        }
      }
    },
    "patron_cubalex": {
      "type": "object",
      "required": ["texto", "rango_casos", "grupos_afectados", "confianza", "fuente", "casos_historicos"],
      "properties": {
        "texto": { "type": "string", "minLength": 40 },
        "rango_casos": { "type": "string" },
        "grupos_afectados": { "type": "array", "items": { "type": "string" } },
        "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
        "fuente": { "type": "string" },
        "casos_historicos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nombre", "anio", "detalle", "confianza", "fuente"],
            "properties": {
              "nombre": { "type": "string" },
              "anio": { "type": "string" },
              "detalle": { "type": "string", "minLength": 20 },
              "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
              "fuente": { "type": "string" }
            }
          }
        }
      }
    },
    "diccionario_etiquetas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["termino", "frente", "peso", "confianza", "nota"],
        "properties": {
          "termino": { "type": "string" },
          "frente": { "type": "string", "enum": ["oficialista", "diaspora"] },
          "peso": { "type": "string", "enum": ["alto", "medio", "bajo"] },
          "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
          "nota": { "type": "string", "minLength": 10 }
        }
      }
    },
    "verificacion": {
      "type": "object",
      "required": ["total_evaluadas", "corroboradas", "no_confirmadas", "excluidas", "nota"],
      "properties": {
        "total_evaluadas": { "type": "integer", "minimum": 1 },
        "corroboradas": { "type": "integer", "minimum": 0 },
        "no_confirmadas": { "type": "integer", "minimum": 0 },
        "excluidas": { "type": "integer", "minimum": 0 },
        "nota": { "type": "string", "minLength": 40 }
      }
    },
    "encuesta": {
      "type": "object",
      "required": ["preguntas"],
      "properties": {
        "preguntas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "texto", "opciones"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z_]+$" },
              "texto": { "type": "string" },
              "opciones": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "referencias": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["fuente", "detalle"],
        "properties": {
          "fuente": { "type": "string" },
          "detalle": { "type": "string" },
          "fecha": { "type": "string" }
        }
      }
    },
    "conclusion": { "type": "string", "minLength": 100 }
  }
}
