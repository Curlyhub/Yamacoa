{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yamacoa.com/data/protesta_solitaria.schema.json",
  "title": "Protesta solitaria",
  "description": "Contrato del dataset respirante del expediente 'Protestar solo': la criminalización de la protesta pacífica individual en Cuba, con el caso de Javier Ernesto Martín Gutiérrez ('Spiderman') como caso índice y un patrón comparable de casos acusados bajo 'desórdenes públicos' entre 2024 y 2026.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "intro", "caso_indice", "patron", "mapa", "radar", "gauges",
    "verificacion", "encuesta", "referencias", "conclusion"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "titulo", "subtitulo", "version", "fecha_datos", "advertencia"],
      "properties": {
        "slug": { "const": "protesta_solitaria" },
        "titulo": { "type": "string" },
        "subtitulo": { "type": "string" },
        "descripcion": {
          "type": "string",
          "description": "Registro factual largo del expediente. Capa descriptiva (/narrar); no la consume el renderer congelado.",
          "minLength": 400
        },
        "narracion": {
          "type": "string",
          "description": "Guion de audio corto para el servidor TTS (tts.yamacoa.com). Cifras en palabras, español.",
          "minLength": 300,
          "maxLength": 1450
        },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "fecha_datos": { "type": "string", "format": "date" },
        "advertencia": { "type": "string", "minLength": 60 }
      }
    },
    "intro": {
      "type": "object",
      "required": ["parrafos"],
      "properties": {
        "parrafos": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 80 }
        }
      }
    },
    "caso_indice": {
      "type": "object",
      "required": ["advertencia", "perfil", "hechos", "linea_tiempo"],
      "properties": {
        "advertencia": { "type": "string", "minLength": 60 },
        "perfil": {
          "type": "object",
          "required": ["nombre", "alias", "disciplina", "lugar"],
          "properties": {
            "nombre": { "type": "string" },
            "alias": { "type": "string" },
            "disciplina": { "type": "string" },
            "lugar": { "type": "string" }
          }
        },
        "hechos": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["afirmacion", "confianza", "fuente"],
            "properties": {
              "afirmacion": { "type": "string", "minLength": 20 },
              "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
              "fuente": { "type": "string", "minLength": 5 },
              "nota": { "type": "string" }
            }
          }
        },
        "linea_tiempo": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["fecha", "estado", "detalle", "confianza", "fuente"],
            "properties": {
              "fecha": { "type": "string" },
              "estado": { "type": "string", "enum": ["protesta", "vacio_informativo", "confirmado"] },
              "detalle": { "type": "string", "minLength": 20 },
              "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
              "fuente": { "type": "string", "minLength": 5 },
              "nota": { "type": "string" }
            }
          }
        }
      }
    },
    "patron": {
      "type": "object",
      "required": ["texto", "cifras", "casos_comparables"],
      "properties": {
        "texto": { "type": "string", "minLength": 40 },
        "cifras": {
          "type": "object",
          "required": ["presos_politicos_pd", "fecha_pd", "encarcelados_diario_de_cuba", "fecha_dc", "nota_divergencia"],
          "properties": {
            "presos_politicos_pd": { "type": "integer", "minimum": 0 },
            "fecha_pd": { "type": "string" },
            "encarcelados_diario_de_cuba": { "type": "integer", "minimum": 0 },
            "fecha_dc": { "type": "string" },
            "nota_divergencia": { "type": "string", "minLength": 40 }
          }
        },
        "casos_comparables": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["nombre", "provincia", "fecha", "cargo", "condena", "confianza", "fuente"],
            "properties": {
              "nombre": { "type": "string" },
              "provincia": { "type": "string" },
              "fecha": { "type": "string" },
              "cargo": { "type": "string" },
              "condena": { "type": "string" },
              "condena_anios_min": { "type": ["number", "null"] },
              "condena_anios_max": { "type": ["number", "null"] },
              "confianza": { "type": "string", "enum": ["corroborada", "no_confirmada"] },
              "fuente": { "type": "string" }
            }
          }
        }
      }
    },
    "mapa": {
      "type": "object",
      "required": ["nota", "puntos"],
      "properties": {
        "nota": { "type": "string" },
        "puntos": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["provincia", "rol", "detalle"],
            "properties": {
              "provincia": { "type": "string" },
              "rol": { "type": "string", "enum": ["caso_indice", "patron_comparable"] },
              "detalle": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "radar": {
      "type": "object",
      "required": ["nota_metodologica", "ejes", "series"],
      "properties": {
        "nota_metodologica": { "type": "string", "minLength": 40 },
        "ejes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["nombre", "valores"],
            "properties": {
              "nombre": { "type": "string" },
              "valores": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "integer", "minimum": 0, "maximum": 3 }
              }
            }
          }
        }
      }
    },
    "gauges": {
      "type": "object",
      "required": ["rechazo_recursos", "dias_custodia"],
      "properties": {
        "rechazo_recursos": {
          "type": "object",
          "required": ["presentados", "rechazados", "fuente"],
          "properties": {
            "presentados": { "type": "integer", "minimum": 0 },
            "rechazados": { "type": "integer", "minimum": 0 },
            "fuente": { "type": "string" }
          }
        },
        "dias_custodia": {
          "type": "object",
          "required": ["dias", "escala_max", "fecha_corte", "nota"],
          "properties": {
            "dias": { "type": "integer", "minimum": 0 },
            "escala_max": { "type": "integer", "minimum": 1 },
            "fecha_corte": { "type": "string" },
            "nota": { "type": "string" }
          }
        }
      }
    },
    "verificacion": {
      "type": "object",
      "required": ["total_evaluadas", "corroboradas", "no_confirmadas", "excluidas", "nota"],
      "properties": {
        "total_evaluadas": { "type": "integer", "minimum": 1 },
        "corroboradas": { "type": "integer", "minimum": 0 },
        "no_confirmadas": { "type": "integer", "minimum": 0 },
        "excluidas": { "type": "integer", "minimum": 0 },
        "nota": { "type": "string", "minLength": 40 }
      }
    },
    "encuesta": {
      "type": "object",
      "required": ["preguntas"],
      "properties": {
        "preguntas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "texto", "opciones"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z_]+$" },
              "texto": { "type": "string" },
              "opciones": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "referencias": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["fuente", "detalle"],
        "properties": {
          "fuente": { "type": "string" },
          "detalle": { "type": "string" },
          "fecha": { "type": "string" }
        }
      }
    },
    "conclusion": { "type": "string", "minLength": 100 }
  }
}
