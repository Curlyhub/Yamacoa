{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yamacoa · expediente racismo estructural (CERD)",
  "type": "object",
  "required": [
    "meta",
    "stats",
    "comparacion",
    "mecanismos",
    "cerd"
  ],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "titulo",
        "actualizado",
        "fuente"
      ]
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "l"
        ],
        "properties": {
          "color": {
            "type": "string",
            "enum": [
              "ochre",
              "plum",
              "garnet",
              "paper"
            ]
          }
        }
      }
    },
    "comparacion": {
      "type": "object",
      "required": [
        "items",
        "sudafrica"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pais",
              "pop",
              "prison",
              "factor",
              "tier"
            ],
            "properties": {
              "pop": {
                "type": "number"
              },
              "prison": {
                "type": "number"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "testimonial",
                  "documentado"
                ]
              }
            }
          }
        }
      }
    },
    "mecanismos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "t",
          "d",
          "eco",
          "ecoD",
          "cerd"
        ]
      }
    },
    "casos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "d"
        ]
      }
    },
    "testimonios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quien",
          "p"
        ]
      }
    },
    "cerd": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "art",
          "d"
        ]
      }
    }
  }
}