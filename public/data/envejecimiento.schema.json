{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "envejecimiento",
  "type": "object",
  "required": ["meta", "piramide", "serie_poblacion", "natalidad_mortalidad", "pensiones", "salud", "contrafactual", "encuesta"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "titulo", "descripcion", "narracion", "fecha_publicacion", "fuentes", "sistema_confianza"],
      "properties": {
        "slug": { "const": "envejecimiento" },
        "titulo": { "type": "string", "minLength": 5 },
        "subtitulo": { "type": "string" },
        "descripcion": { "type": "string", "minLength": 400 },
        "narracion": { "type": "string", "minLength": 300, "maxLength": 1450 },
        "fecha_publicacion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fuentes": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
        "sistema_confianza": { "type": "object" },
        "notas_metodologicas": { "type": "array", "items": { "type": "string" } },
        "tesis_confianza": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["afirmacion", "nivel"],
            "properties": {
              "afirmacion": { "type": "string" },
              "nivel": { "enum": ["confirmado", "reportado", "estimado"] }
            }
          }
        }
      }
    },
    "piramide": {
      "type": "object",
      "required": ["escenarios"],
      "properties": {
        "advertencia": { "type": "string" },
        "escenarios": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "nombre", "anclas"],
            "properties": {
              "id": { "enum": ["real", "contrafactual"] },
              "nombre": { "type": "string" },
              "advertencia": { "type": "string" },
              "anclas": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["anio", "confianza", "poblacion_total", "pct_60_mas", "mediana_edad", "grupos"],
                  "properties": {
                    "anio": { "type": "integer", "minimum": 2020, "maximum": 2100 },
                    "confianza": { "enum": ["confirmado", "reportado", "estimado"] },
                    "nota": { "type": "string" },
                    "poblacion_total": { "type": "number", "exclusiveMinimum": 0 },
                    "pct_60_mas": { "type": "number", "minimum": 0, "maximum": 100 },
                    "mediana_edad": { "type": "number", "exclusiveMinimum": 0 },
                    "grupos": {
                      "type": "array",
                      "minItems": 9,
                      "maxItems": 9,
                      "items": {
                        "type": "object",
                        "required": ["edad", "hombres", "mujeres"],
                        "properties": {
                          "edad": { "type": "string" },
                          "hombres": { "type": "number", "minimum": 0 },
                          "mujeres": { "type": "number", "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "serie_poblacion": {
      "type": "object",
      "required": ["oficial"],
      "properties": {
        "advertencia": { "type": "string" },
        "oficial": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["anio", "valor", "confianza"],
            "properties": {
              "anio": { "type": "integer" },
              "valor": { "type": "number", "exclusiveMinimum": 0 },
              "confianza": { "enum": ["confirmado", "reportado", "estimado"] }
            }
          }
        },
        "estimacion_independiente": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["anio", "valor", "confianza"],
            "properties": {
              "anio": { "type": "integer" },
              "valor": { "type": "number", "exclusiveMinimum": 0 },
              "confianza": { "enum": ["confirmado", "reportado", "estimado"] }
            }
          }
        }
      }
    },
    "natalidad_mortalidad": {
      "type": "object",
      "required": ["serie", "saldo_natural_2025", "tasa_fecundidad"],
      "properties": {
        "serie": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["anio", "nacimientos", "defunciones"],
            "properties": {
              "anio": { "type": "integer" },
              "nacimientos": { "type": "integer", "exclusiveMinimum": 0 },
              "defunciones": { "type": "integer", "exclusiveMinimum": 0 },
              "confianza_nacimientos": { "enum": ["confirmado", "reportado", "estimado"] },
              "confianza_defunciones": { "enum": ["confirmado", "reportado", "estimado"] }
            }
          }
        },
        "saldo_natural_2025": { "type": "integer" },
        "tasa_fecundidad": {
          "type": "object",
          "required": ["valor", "nivel_reemplazo"],
          "properties": {
            "valor": { "type": "number", "exclusiveMinimum": 0 },
            "nivel_reemplazo": { "type": "number", "exclusiveMinimum": 0 },
            "anio": { "type": "integer" },
            "confianza": { "enum": ["confirmado", "reportado", "estimado"] }
          }
        }
      }
    },
    "pensiones": {
      "type": "object",
      "required": ["jubilados_total", "pension_minima_cup", "canasta_basica_cup_min", "canasta_basica_cup_max", "encuesta_asic"],
      "properties": {
        "jubilados_total": { "type": "integer", "exclusiveMinimum": 0 },
        "pct_poblacion": { "type": "number" },
        "confianza_jubilados": { "enum": ["confirmado", "reportado", "estimado"] },
        "pension_minima_cup": { "type": "number", "exclusiveMinimum": 0 },
        "pension_minima_usd_informal_min": { "type": "number" },
        "pension_minima_usd_informal_max": { "type": "number" },
        "vigente_desde": { "type": "string" },
        "confianza_pension_minima": { "enum": ["confirmado", "reportado", "estimado"] },
        "canasta_basica_cup_min": { "type": "number", "exclusiveMinimum": 0 },
        "canasta_basica_cup_max": { "type": "number", "exclusiveMinimum": 0 },
        "confianza_canasta": { "enum": ["confirmado", "reportado", "estimado"] },
        "cobertura_pct_min": { "type": "number" },
        "cobertura_pct_max": { "type": "number" },
        "encuesta_asic": {
          "type": "object",
          "required": ["n", "pct_no_cubre", "advertencia"],
          "properties": {
            "n": { "type": "integer", "exclusiveMinimum": 0 },
            "pct_no_cubre": { "type": "number" },
            "fecha": { "type": "string" },
            "advertencia": { "type": "string", "minLength": 10 }
          }
        }
      }
    },
    "salud": {
      "type": "object",
      "required": ["profesionales_emigrados_2021_2024", "medicos_2021", "medicos_2024", "habitantes_por_medico_2021", "habitantes_por_medico_2024"],
      "properties": {
        "profesionales_emigrados_2021_2024": { "type": "integer", "exclusiveMinimum": 0 },
        "confianza_profesionales": { "enum": ["confirmado", "reportado", "estimado"] },
        "medicos_2021": { "type": "integer", "exclusiveMinimum": 0 },
        "medicos_2024": { "type": "integer", "exclusiveMinimum": 0 },
        "caida_pct": { "type": "number" },
        "habitantes_por_medico_2021": { "type": "number" },
        "habitantes_por_medico_2024": { "type": "number" },
        "confianza_medicos": { "enum": ["confirmado", "reportado", "estimado"] },
        "escasez_medicamentos_pct": { "type": "number" },
        "confianza_escasez": { "enum": ["confirmado", "reportado", "estimado"] }
      }
    },
    "contrafactual": {
      "type": "object",
      "required": ["titulo", "advertencia", "parrafos"],
      "properties": {
        "titulo": { "type": "string" },
        "advertencia": { "type": "string", "minLength": 10 },
        "parrafos": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "encuesta": {
      "type": "object",
      "required": ["titulo", "tabla_supabase", "rpc_incrementar", "preguntas"],
      "properties": {
        "titulo": { "type": "string" },
        "intro": { "type": "string" },
        "tabla_supabase": { "type": "string" },
        "rpc_incrementar": { "type": "string" },
        "preguntas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "texto", "opciones"],
            "properties": {
              "id": { "type": "string" },
              "texto": { "type": "string" },
              "opciones": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["id", "texto"],
                  "properties": { "id": { "type": "string" }, "texto": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
