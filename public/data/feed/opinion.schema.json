{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yamacoa.com/data/feed/opinion.schema.json",
  "title": "Artículos de opinión de Yamacoa",
  "description": "Lo exporta ops/opinion/opinion.mjs desde la BD (opinion_articulos, estado publicado) en cada despliegue. `texto` es el del autor, INVARIANTE (texto_sha256); `datos` es lo único que añade Yamacoa, y la UI lo pinta aparte y rotulado. Si no hay artículos, la sección no se muestra.",
  "type": "object",
  "required": ["version", "actualizado", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "actualizado": { "type": "string", "format": "date-time" },
    "items": { "type": "array", "items": { "$ref": "#/definitions/articulo" } }
  },
  "definitions": {
    "articulo": {
      "type": "object",
      "required": ["id", "slug", "titulo", "firma", "firma_tipo", "publicado", "texto", "texto_sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^o-[a-z0-9-]+$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]{4,90}$" },
        "titulo": { "type": "string", "minLength": 8, "maxLength": 160 },
        "firma": { "type": "string", "minLength": 2, "maxLength": 80 },
        "firma_tipo": { "type": "string", "enum": ["nombre", "seudonimo"] },
        "presentacion": { "type": "string", "maxLength": 240 },
        "publicado": { "type": "string", "format": "date-time" },
        "texto": { "type": "string", "minLength": 400, "description": "Texto del autor, tal cual. Párrafos separados por una línea en blanco." },
        "texto_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "video": {
          "type": "object",
          "required": ["url", "tras"],
          "additionalProperties": false,
          "description": "Vídeo citado por el autor (post de X o YouTube), incrustado tras el párrafo `tras` (1 = el primero). Se carga al pulsar.",
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://(x\\.com|twitter\\.com|www\\.youtube\\.com|youtu\\.be)/" },
            "tras": { "type": "integer", "minimum": 1 }
          }
        },
        "datos": {
          "type": "object",
          "additionalProperties": false,
          "description": "Lo que añade Yamacoa, aparte: contexto con datos, gráfico y notas de datos neutrales.",
          "properties": {
            "contexto": {
              "type": "array", "maxItems": 3,
              "items": { "type": "object", "required": ["texto", "citas"], "additionalProperties": false,
                "properties": { "texto": { "type": "string", "minLength": 40, "maxLength": 900 },
                  "citas": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } } } }
            },
            "grafico": { "$ref": "noticias.schema.json#/definitions/grafico" },
            "notas": {
              "type": "array", "maxItems": 6,
              "items": { "type": "object", "required": ["fragmento", "nota", "citas"], "additionalProperties": false,
                "properties": { "fragmento": { "type": "string", "description": "Palabras literales del autor." },
                  "nota": { "type": "string", "minLength": 20, "maxLength": 500 },
                  "citas": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } } } }
            },
            "fuentes": {
              "type": "array",
              "items": { "type": "object", "required": ["nombre", "tipo"], "additionalProperties": false,
                "properties": { "nombre": { "type": "string" }, "url": { "type": "string", "format": "uri" },
                  "tipo": { "type": "string", "enum": ["primaria", "medio", "dataset"] } } }
            },
            "expediente": { "type": "string", "pattern": "^/[a-z0-9_-]+$" }
          }
        }
      }
    }
  }
}
