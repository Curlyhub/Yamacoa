{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yamacoa.com/data/feed/estudios.schema.json",
  "title": "Estudios automáticos de Yamacoa",
  "description": "Índice (estudios.json) y detalle (estudios/<slug>.json). Los gráficos salen de una biblioteca CERRADA: serie | barras | cifra.",
  "oneOf": [{ "$ref": "#/definitions/indice" }, { "$ref": "#/definitions/detalle" }],
  "definitions": {
    "indice": {
      "type": "object",
      "required": ["version", "actualizado", "items"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "actualizado": { "type": "string", "format": "date-time" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/resumen" } }
      }
    },
    "base": {
      "type": "object",
      "required": ["id", "slug", "seccion", "titulo", "resumen", "noticias", "relevancia", "fuentesDatos", "creado", "audio"],
      "properties": {
        "id": { "type": "string", "pattern": "^e-[a-z0-9-]+$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]{4,90}$" },
        "seccion": { "type": "string" },
        "titulo": { "type": "string", "minLength": 12, "maxLength": 140 },
        "resumen": { "type": "string", "minLength": 40, "maxLength": 600 },
        "noticias": { "type": "array", "minItems": 3, "items": { "type": "string" }, "description": "ids de las noticias de origen" },
        "relevancia": { "type": "number", "minimum": 0, "maximum": 100 },
        "fuentesDatos": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "creado": { "type": "string", "format": "date-time" },
        "audio": { "$ref": "#/definitions/audio" },
        "grafico": { "$ref": "#/definitions/grafico" }
      }
    },
    "resumen": { "allOf": [{ "$ref": "#/definitions/base" }] },
    "detalle": {
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "required": ["secciones", "limitaciones"],
          "properties": {
            "secciones": {
              "type": "array", "minItems": 2,
              "items": {
                "type": "object", "required": ["parrafos"], "additionalProperties": false,
                "properties": {
                  "titulo": { "type": "string" },
                  "parrafos": { "type": "array", "items": { "type": "string" } },
                  "grafico": { "$ref": "#/definitions/grafico" }
                }
              }
            },
            "limitaciones": { "type": "string", "minLength": 30, "description": "Subregistro, sesgo de reporte, sin causalidad: siempre visible." }
          }
        }
      ]
    },
    "audio": {
      "type": "object", "required": ["url", "duracion"], "additionalProperties": false,
      "properties": { "url": { "type": "string", "format": "uri" }, "duracion": { "type": "number", "minimum": 1 }, "voz": { "type": "string" } }
    },
    "grafico": {
      "type": "object",
      "required": [
        "tipo",
        "datos",
        "fuente"
      ],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "serie",
            "barras",
            "cifra",
            "comparacion",
            "proporcion",
            "mapa"
          ],
          "description": "serie: evolución en el tiempo. barras: ranking o categorías. cifra: un número. comparacion: dos valores (antes y después, oficial frente a otra fuente) con su variación. proporcion: partes de un total (total obligatorio). mapa: valores por provincia (etiqueta = nombre de la provincia)."
        },
        "titulo": {
          "type": "string"
        },
        "unidad": {
          "type": "string"
        },
        "unidadCorta": {
          "type": "string"
        },
        "ejeX": {
          "type": "string"
        },
        "fuente": {
          "type": "string"
        },
        "nota": {
          "type": "string"
        },
        "datos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "etiqueta"
            ],
            "additionalProperties": false,
            "properties": {
              "etiqueta": {
                "type": "string"
              },
              "valor": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "prefijo": {
                "type": "string"
              },
              "sufijo": {
                "type": "string"
              }
            }
          }
        },
        "serie": {
          "type": "string",
          "description": "id de la serie de referencia (series.json) de la que sale: los datos los pone el ciclo."
        },
        "destacar": {
          "type": "string",
          "description": "etiqueta del punto que se destaca (el dato de hoy)."
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "proporcion: el total del que los datos son partes."
        },
        "orden": {
          "type": "string",
          "enum": [
            "valor",
            "original"
          ],
          "description": "barras: por valor (defecto) o en el orden dado (cronológico)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "comparacion"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "proporcion"
              }
            }
          },
          "then": {
            "required": [
              "total"
            ],
            "properties": {
              "datos": {
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "mapa"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "maxItems": 16,
                "items": {
                  "properties": {
                    "etiqueta": {
                      "enum": [
                        "Pinar del Río",
                        "Artemisa",
                        "La Habana",
                        "Mayabeque",
                        "Matanzas",
                        "Villa Clara",
                        "Cienfuegos",
                        "Sancti Spíritus",
                        "Ciego de Ávila",
                        "Camagüey",
                        "Las Tunas",
                        "Holguín",
                        "Granma",
                        "Santiago de Cuba",
                        "Guantánamo",
                        "Isla de la Juventud"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
