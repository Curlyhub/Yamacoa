# Encuestas globales (Supabase). Copiar a .env.local (gitignored) y rellenar.
# Sin estas variables las encuestas siguen funcionando, pero los votos se
# guardan sólo en el navegador de cada visitante (localStorage).
#
# La anon key es pública por diseño: RLS impide escribir en poll_votes salvo
# a través de la RPC poll_increment, que sólo suma 1. Ver ops/*/poll_supabase.sql.
#
# CRA las inlinea en el bundle EN TIEMPO DE BUILD: hay que hacer `npm run build`
# con .env.local presente antes de `wrangler pages deploy`.
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=
